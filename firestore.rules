rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidWallet(w) {
      return w is map
        && w.keys().hasAll(['coins', 'credits'])
        && w.keys().hasOnly(['coins', 'credits'])
        && w.coins is number && w.coins >= 0 && w.coins <= 10000000
        && w.credits is number && w.credits >= 0 && w.credits <= 10000000;
    }

    function isValidStats(s) {
      return s is map
        && s.keys().hasAll(['distanceRun', 'enemiesDefeated', 'damageDealt', 'goldCollected', 'runs', 'highestDistance'])
        && s.keys().hasOnly(['distanceRun', 'enemiesDefeated', 'damageDealt', 'goldCollected', 'runs', 'highestDistance'])
        && s.distanceRun is number && s.distanceRun >= 0 && s.distanceRun <= 100000000
        && s.enemiesDefeated is number && s.enemiesDefeated >= 0 && s.enemiesDefeated <= 10000000
        && s.damageDealt is number && s.damageDealt >= 0 && s.damageDealt <= 1000000000
        && s.goldCollected is number && s.goldCollected >= 0 && s.goldCollected <= 100000000
        && s.runs is number && s.runs >= 0 && s.runs <= 1000000
        && s.highestDistance is number && s.highestDistance >= 0 && s.highestDistance <= 100000;
    }

    function isValidLoadout(l) {
      return l is map
        && l.keys().hasAll(['operatorId', 'weaponId', 'gadgetIds', 'droneEnabled', 'droneModelId'])
        && l.keys().hasOnly(['operatorId', 'weaponId', 'gadgetIds', 'droneEnabled', 'droneModelId'])
        && l.operatorId is string && l.operatorId.size() > 0 && l.operatorId.size() <= 40
        && l.weaponId is string && l.weaponId.size() > 0 && l.weaponId.size() <= 40
        && l.gadgetIds is list && l.gadgetIds.size() <= 2
        && l.droneEnabled is bool
        && l.droneModelId is string && l.droneModelId.size() > 0 && l.droneModelId.size() <= 40;
    }

    function isValidDailyMissions(dm) {
      return dm is map
        && dm.keys().hasAll(['dateKey', 'progress', 'claimedIds'])
        && dm.keys().hasOnly(['dateKey', 'progress', 'claimedIds'])
        && dm.dateKey is string
        && dm.dateKey.size() == 10
        && dm.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && dm.progress is map
        && dm.progress.keys().hasAll(['daily_run_500m', 'daily_kills_50', 'daily_gold_150', 'daily_runs_2', 'daily_boss_1'])
        && dm.progress.keys().hasOnly(['daily_run_500m', 'daily_kills_50', 'daily_gold_150', 'daily_runs_2', 'daily_boss_1'])
        && dm.progress.daily_run_500m is number && dm.progress.daily_run_500m >= 0 && dm.progress.daily_run_500m <= 100000
        && dm.progress.daily_kills_50 is number && dm.progress.daily_kills_50 >= 0 && dm.progress.daily_kills_50 <= 10000
        && dm.progress.daily_gold_150 is number && dm.progress.daily_gold_150 >= 0 && dm.progress.daily_gold_150 <= 100000
        && dm.progress.daily_runs_2 is number && dm.progress.daily_runs_2 >= 0 && dm.progress.daily_runs_2 <= 1000
        && dm.progress.daily_boss_1 is number && dm.progress.daily_boss_1 >= 0 && dm.progress.daily_boss_1 <= 1000
        && dm.claimedIds is list
        && dm.claimedIds.size() <= 5
        && dm.claimedIds.hasOnly(['daily_run_500m', 'daily_kills_50', 'daily_gold_150', 'daily_runs_2', 'daily_boss_1']);
    }

    function isValidOperativeProfile(data, uid) {
      return data.keys().hasAll([
          'uid', 'username', 'avatarId', 'bio', 'wallet', 'stats', 'ownedItems', 'loadout', 'dailyMissions', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'username', 'avatarId', 'bio', 'wallet', 'stats', 'ownedItems', 'loadout', 'dailyMissions', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == uid
        && data.username is string
        && data.username.size() >= 3
        && data.username.size() <= 18
        && data.username.matches('^[a-zA-Z0-9_-]+$')
        && data.avatarId is string
        && data.avatarId in ['avatar_specter', 'avatar_wraith', 'avatar_aegis', 'avatar_valkyrie']
        && data.bio is string
        && data.bio.size() <= 140
        && isValidWallet(data.wallet)
        && isValidStats(data.stats)
        && data.ownedItems is list
        && data.ownedItems.size() >= 1
        && data.ownedItems.size() <= 40
        && data.ownedItems[0] is string
        && data.ownedItems[0].size() <= 64
        && isValidLoadout(data.loadout)
        && isValidDailyMissions(data.dailyMissions)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /operatives/{uid} {
      allow get: if isValidId(uid) && isOwner(uid);
      allow list: if false;
      allow create: if isValidId(uid)
        && isOwner(uid)
        && isValidOperativeProfile(incoming(), uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(uid)
        && isOwner(uid)
        && isValidOperativeProfile(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'username', 'avatarId', 'bio', 'wallet', 'stats', 'ownedItems', 'loadout', 'dailyMissions', 'updatedAt'
        ]);
      allow delete: if isValidId(uid) && isOwner(uid);
    }
  }
}
